{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AB Dock",
  "version": "1.4.2",
  "identifier": "com.aerodock.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "dock",
        "title": "AB Dock",
        "width": 1200,
        "height": 220,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "visible": false,
        "acceptFirstMouse": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPDATA\\**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDNUREMkI1NjJEMUFEQUIKUldTcnJkRml0ZEpkbkwxcXRkOVRqVmFYKzFkN3doa0x1MmhkcWo2aWc5QkRwK09YSEtZK0lxRy8K",
      "endpoints": [
        "https://github.com/abaeming-beep/aero-dock/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "Ryan Panda",
    "copyright": "Copyright (c) 2026 Ryan Panda",
    "category": "Utility",
    "shortDescription": "An app dock for Windows",
    "longDescription": "AB Dock is an app dock for Windows, a personal fork of Aero Dock.",
    "homepage": "https://github.com/TheAgencyMGE/aero-dock",
    "license": "MIT"
  }
}
